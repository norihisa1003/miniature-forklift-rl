<?xml version="1.0"?>
<sdf version="1.10">
  <model name="forklift">
    <pose>0 0 0.13 0 0 0</pose>

    <!-- ── 1. Main body ── -->
    <link name="base_link">
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.08</ixx><iyy>0.10</iyy><izz>0.10</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="base_visual">
        <geometry>
          <box><size>0.4 0.25 0.12</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.0 1</ambient>
          <diffuse>0.9 0.7 0.0 1</diffuse>
        </material>
      </visual>
      <collision name="base_collision">
        <geometry>
          <box><size>0.4 0.25 0.12</size></box>
        </geometry>
      </collision>
    </link>

    <!-- ── 2. Left drive wheel ── -->
    <link name="left_wheel">
      <!-- pose: x y z roll pitch yaw  (roll=pi/2 to orient cylinder axis laterally) -->
      <pose>0.0 0.175 -0.07 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="left_wheel_visual">
        <geometry>
          <cylinder><radius>0.06</radius><length>0.04</length></cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="left_wheel_collision">
        <geometry>
          <cylinder><radius>0.06</radius><length>0.04</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <!-- mu: longitudinal friction, mu2: lateral friction -->
            <ode><mu>1.0</mu><mu2>0.5</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- ── 3. Right drive wheel ── -->
    <link name="right_wheel">
      <pose>0.0 -0.175 -0.07 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="right_wheel_visual">
        <geometry>
          <cylinder><radius>0.06</radius><length>0.04</length></cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="right_wheel_collision">
        <geometry>
          <cylinder><radius>0.06</radius><length>0.04</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.5</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- ── 4. Rear caster (friction-free ball to prevent tipping) ── -->
    <link name="caster">
      <pose>-0.15 0 -0.1 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="caster_visual">
        <geometry>
          <sphere><radius>0.03</radius></sphere>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
        </material>
      </visual>
      <collision name="caster_collision">
        <geometry>
          <sphere><radius>0.03</radius></sphere>
        </geometry>
        <surface>
          <friction>
            <!-- Zero friction so the caster does not resist turning -->
            <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- ── 5. Joints ── -->
    <!-- Continuous revolute joints for the drive wheels -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- Fixed joint: caster does not rotate relative to body -->
    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>

    <!-- ── 6. Differential drive plugin ── -->
    <!--
      NOTE: Real forklifts use Ackermann steering (2 front drive wheels +
      1 rear steering wheel). Differential drive is used here instead because:
        - The built-in DiffDrive plugin requires no extra tuning
        - Action/observation space design is simpler for Phase 1 RL training
        - Switch to Ackermann in Phase 3 if sim-to-real accuracy requires it
    -->
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.35</wheel_separation>
      <wheel_radius>0.06</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

  </model>
</sdf>